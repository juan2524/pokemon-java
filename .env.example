# Copy to .env and adjust locally. Do not commit real secrets.

# --- Postgres ---
POSTGRES_DB=pokemon
POSTGRES_USER=pokemon
POSTGRES_PORT=5432
# Set a strong password for shared/demo environments (compose defaults to "pokemon").
# POSTGRES_PASSWORD=

# --- Ports ---
BACKEND_PORT=8080
FRONTEND_PORT=80

# --- Backend ---
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
# Comma-separated browser origins allowed by Spring CORS.
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173
# Provide a long random secret in any non-local environment.
# JWT_SECRET=

# --- Frontend build (baked into the static bundle) ---
# Leave empty so the SPA calls same-origin /api (Nginx proxies to backend).
# For Vite local dev against a remote API, set e.g. http://localhost:8080
VITE_API_BASE_URL=
